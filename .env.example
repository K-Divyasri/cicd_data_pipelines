# Copy this file to ".env" and fill in real values. ".env" is git-ignored so your
# secrets never get committed. In GitHub Actions these come from repo Secrets
# instead (Settings -> Secrets and variables -> Actions).

# Where the DuckDB warehouse file lives (relative to the build/ root).
WAREHOUSE_DB=warehouse.duckdb

# Example of a real secret you'd add later if you swapped DuckDB for cloud Postgres:
# DB_URL=postgresql://user:password@host:5432/dbname
